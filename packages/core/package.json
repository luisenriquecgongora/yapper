{
  "name": "@yapper/core",
  "version": "1.0.0",
  "description": "Zero-dependency universal speech-to-text core running on-device WebGPU Whisper, self-healing 0ms Web Speech API, and real-time streaming agreement.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": [
    "whisper",
    "speech-to-text",
    "webgpu",
    "transformers.js",
    "onnx",
    "audio",
    "stt",
    "streaming"
  ],
  "author": "Luis Enrique <luisenriquecgongora@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.3.0 || ^4.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
