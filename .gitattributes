# ==============================================================================
# GitHub Linguist Language Detection Configuration
# Establishes Python as the Primary Language for Yapper
# ==============================================================================

# Treat frontend client distribution packages and demo web app as vendored client SDKs
packages/** linguist-vendored
apps/** linguist-vendored

# Mark test suites as documentation so only production library code is measured
**/*.test.ts linguist-documentation
**/*.test.tsx linguist-documentation
services/yapper-engine/tests/** linguist-documentation

# Ensure all Python engine, DSP, evals, and benchmark files are recognized as primary code
services/yapper-engine/**/*.py linguist-detectable=true
services/yapper-engine/**/*.py linguist-language=Python
evals/**/*.py linguist-detectable=true
benchmarks/**/*.py linguist-detectable=true

# Consistent line endings across operating systems
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Collapse lockfiles and build outputs in PRs and git diffs
*lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
dist/** linguist-generated=true
build/** linguist-generated=true
out/** linguist-generated=true
*.min.js linguist-generated=true
*.min.css linguist-generated=true
*.generated.* linguist-generated=true
*.d.ts.map linguist-generated=true
